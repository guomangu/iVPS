# ==============================================================================
# IVPS Stack - Fichier de Configuration d'Environnement
# ==============================================================================

# Nom de domaine principal du VPS
DOMAIN_NAME=votre-domaine.com

# Sous-domaines pour les services centraux
COCKPIT_SUBDOMAIN=admin
SFTPGO_SUBDOMAIN=fichiers

# Ports de routage Zoraxy (Reverse Proxy)
ZORAXY_HTTP_PORT=80
ZORAXY_HTTPS_PORT=443
ZORAXY_ADMIN_PORT=8000
ZORAXY_IMAGE=zoraxydocker/zoraxy:latest

# Ports et images SFTPGo (Gestionnaire de fichiers & SFTP)
SFTPGO_WEB_PORT=8080
SFTPGO_SFTP_PORT=2022
SFTPGO_IMAGE=drakkan/sftpgo:latest

# Cockpit (Administration système native)
COCKPIT_PORT=9090

# Réseau Podman et répertoires de persistance
PODMAN_NETWORK=ivps-net
DATA_DIR=./data

# Sécurité & Système
ENABLE_UNPRIVILEGED_PORTS=true
TZ=UTC
