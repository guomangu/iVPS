{
  "ProxyType": 1,
  "RootOrMatchingDomain": "admin.votre-domaine.com",
  "MatchingDomainAlias": [],
  "ActiveOrigins": [{
    "OriginIpOrDomain": "host.containers.internal:9090",
    "RequireTLS": false,
    "SkipCertValidations": false,
    "SkipWebSocketOriginCheck": true,
    "Weight": 1, "MaxConn": 0, "RespTimeout": 0
