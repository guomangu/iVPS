# ==============================================================================
# IVPS Stack - Configuration Principale
# ==============================================================================

# Nom de domaine principal
DOMAIN_NAME=sweaw.com

# Sous-domaines d'accès aux interfaces
ZORAXY_SUBDOMAIN=proxy
COCKPIT_SUBDOMAIN=admin
PGADMIN_SUBDOMAIN=db

# Utilisateur administrateur unifié (Cockpit, Zoraxy, pgAdmin)
# Renseignez votre utilisateur système natif du VPS pour le synchroniser,
# ou laissez 'admin' pour en créer un nouveau.
ADMIN_USER=fedora

# Mot de passe centralisé (vide = génération aléatoire automatique)
ADMIN_PASSWORD=

# Ports d'écoute des services (ajustés dynamiquement si occupés)
ZORAXY_HTTP_PORT=80
ZORAXY_HTTPS_PORT=443
ZORAXY_ADMIN_PORT=8000
PGADMIN_PORT=5050
COCKPIT_PORT=9090

# Images des conteneurs
ZORAXY_IMAGE=zoraxydocker/zoraxy:latest
PGADMIN_IMAGE=dpage/pgadmin4:latest

# Réseau Podman et persistance des données
PODMAN_NETWORK=ivps-net
DATA_DIR=./data
ENABLE_UNPRIVILEGED_PORTS=true
TZ=UTC

# ------------------------------------------------------------------------------
# WireGuard (wg-easy) - conteneur Podman ROOTFUL dédié
# ------------------------------------------------------------------------------
# Seul wg-easy est rootful : il crée wg0 dans le namespace réseau de l'hôte
# pour que le tunnel 10.8.0.0/24 soit joignable par Zoraxy.
WG_ENABLED=true
WG_SUBDOMAIN=vpn
WG_IMAGE=ghcr.io/wg-easy/wg-easy:15

# UI wg-easy : 127.0.0.1 = privée, exposée uniquement via Zoraxy (recommandé).
# Mettez 0.0.0.0 pour un accès direct (le port TCP sera alors ouvert).
WG_UI_PORT=9999
WG_UI_BIND=127.0.0.1
# false = cookies sécurisés derrière le TLS de Zoraxy ; true = HTTP direct.
WG_INSECURE=false

# Écoute WireGuard et sous-réseau du tunnel
WG_LISTEN_PORT=51820
WG_TUNNEL_CIDR=10.8.0.0/24
WG_DNS=1.1.1.1
WG_ALLOWED_IPS=0.0.0.0/0,::/0
WG_DISABLE_IPV6=false

# Premier démarrage uniquement (base vide). Vide = valeur unifiée.
WG_INIT_ENABLED=true
# vide = ADMIN_USER
WG_INIT_USERNAME=
# vide = ADMIN_PASSWORD
WG_INIT_PASSWORD=
# vide = détection automatique de l IP publique
WG_INIT_HOST=

# auto = interface de la route par défaut (ens3, eth0, ...)
WG_WAN_DEVICE=auto
# Import automatique des données de l'ancien projet reversevpn
WG_LEGACY_DIR=../reversevpn
